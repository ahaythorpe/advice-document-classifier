{
  "id": "stage-nested",
  "name": "Client, then advice event, then step",
  "description": "Each client has a folder with one folder per advice event. Inside each event the documents sit in a folder for their step of the financial planning process: goals and situation, advice and implementation.",
  "charset": "unicode",
  "max_path_chars": 260,
  "max_name_chars": 120,
  "extra_illegal_chars": "",
  "folders": {
    "client": "{client}",
    "event": "{event_date:%Y-%m} - {subject}",
    "category": "{category}",
    "client_level": "_Client-level documents",
    "licensee": "_Licensee documents",
    "review": "_Needs review",
    "stage": "{stage}"
  },
  "layout": {
    "event_document": [
      "client",
      "event",
      "stage"
    ],
    "client_level_document": [
      "client",
      "client_level"
    ],
    "licensee_document": [
      "licensee"
    ],
    "review_with_client": [
      "client",
      "review"
    ],
    "review_without_client": [
      "review"
    ]
  },
  "filename": {
    "client_document": "{date:%Y-%m-%d} - {client} - {type_label}",
    "licensee_document": "{date:%Y-%m-%d} - {type_label}",
    "undated": "undated",
    "keep_original": false
  },
  "type_labels": {},
  "categories": {}
}
