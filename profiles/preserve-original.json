{
  "id": "preserve-original",
  "name": "Nested, original filenames kept",
  "description": "Same folders as nested-default but the original filename is appended to every proposal. For firms whose registers, emails or audit trails cite documents by their existing name, where a clean rename would break the reference.",
  "charset": "unicode",
  "max_path_chars": 260,
  "max_name_chars": 150,
  "extra_illegal_chars": "",
  "folders": {
    "client": "{client}",
    "event": "{event_date:%Y-%m} — {subject} [{record_label}{sub_kind_suffix}]",
    "category": "{category}",
    "client_level": "_Client-level documents",
    "licensee": "_Licensee documents",
    "review": "_Needs review"
  },
  "layout": {
    "event_document": [
      "client",
      "event"
    ],
    "client_level_document": [
      "client",
      "client_level"
    ],
    "licensee_document": [
      "licensee"
    ],
    "review_with_client": [
      "client",
      "review"
    ],
    "review_without_client": [
      "review"
    ]
  },
  "filename": {
    "client_document": "{date:%Y-%m-%d} - {client} - {type_label}",
    "licensee_document": "{date:%Y-%m-%d} - {type_label}",
    "undated": "undated",
    "keep_original": true
  },
  "type_labels": {},
  "categories": {}
}
