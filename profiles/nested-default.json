{
  "id": "nested-default",
  "name": "Client, then advice event",
  "description": "Each client has a folder. Inside it is one folder for each advice event with every document that belongs to it. A document is placed by two checks that must agree: the right client and the right advice event.",
  "charset": "unicode",
  "max_path_chars": 260,
  "max_name_chars": 120,
  "extra_illegal_chars": "",
  "folders": {
    "client": "{client}",
    "event": "{event_date:%Y-%m} - {subject}",
    "category": "{category}",
    "client_level": "_Client-level documents",
    "licensee": "_Licensee documents",
    "review": "_Needs review"
  },
  "layout": {
    "event_document": [
      "client",
      "event"
    ],
    "client_level_document": [
      "client",
      "client_level"
    ],
    "licensee_document": [
      "licensee"
    ],
    "review_with_client": [
      "client",
      "review"
    ],
    "review_without_client": [
      "review"
    ]
  },
  "filename": {
    "client_document": "{date:%Y-%m-%d} - {client} - {type_label}",
    "licensee_document": "{date:%Y-%m-%d} - {type_label}",
    "undated": "undated",
    "keep_original": false
  },
  "type_labels": {},
  "categories": {}
}
