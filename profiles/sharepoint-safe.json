{
  "id": "sharepoint-safe",
  "name": "SharePoint or OneDrive safe",
  "description": "Plain characters only and shorter paths. SharePoint and OneDrive reject some characters and limit how long a path can be. Use this for any synced folder including Teams.",
  "charset": "ascii",
  "max_path_chars": 210,
  "max_name_chars": 80,
  "extra_illegal_chars": "#%&{}~+",
  "folders": {
    "client": "{client}",
    "event": "{event_date:%Y-%m} {subject}",
    "category": "{category}",
    "client_level": "Client Level",
    "licensee": "Licensee",
    "review": "Needs Review"
  },
  "layout": {
    "event_document": [
      "client",
      "event"
    ],
    "client_level_document": [
      "client",
      "client_level"
    ],
    "licensee_document": [
      "licensee"
    ],
    "review_with_client": [
      "client",
      "review"
    ],
    "review_without_client": [
      "review"
    ]
  },
  "filename": {
    "client_document": "{date:%Y-%m-%d} {client} {type_label}",
    "licensee_document": "{date:%Y-%m-%d} {type_label}",
    "undated": "undated",
    "keep_original": false
  },
  "type_labels": {},
  "categories": {}
}
